<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rl_bridge</name>
  <version>0.1.0</version>
  <description>把 cmd_vel 复制到 UDS，并把 UDS 上的里程计解码成 rl_odom。不替换仿真里的 /cmd_vel。</description>
  <maintainer email="foggy111@users.noreply.github.com">foggy111</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rl_transport</depend>
  <build_depend>protobuf-dev</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
